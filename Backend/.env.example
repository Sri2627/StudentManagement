MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=students
MONGODB_IMAGE_BUCKET=<bucket-name>
JWT_SECRET=<generate-a-long-random-secret>
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
CORS_ORIGINS=http://localhost:4200,http://localhost:3200
PORT=8080
# Optional first-run admin bootstrap. Use a unique username and a strong,
# randomly generated password; both values must be set together.
BOOTSTRAP_ADMIN_USERNAME=<your-admin-username>
BOOTSTRAP_ADMIN_PASSWORD=<unique-password-of-16-to-72-bytes>
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
